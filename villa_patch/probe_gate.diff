index ff6d1fe..034248e 100644
--- a/vesuvius/tests/ink_detection/test_dynamic_labels.py
+++ b/vesuvius/tests/ink_detection/test_dynamic_labels.py
@@ -399,3 +399,44 @@ def test_real_dinovol_teacher_strict_loads_when_configured():
 
     assert sum(parameter.numel() for parameter in model.parameters()) > 0
     assert all(not parameter.requires_grad for parameter in model.parameters())
+
+
+def test_probe_guided_generator_uses_probe_without_minmax(tmp_path):
+    """probe_weights switches the DINO-guided recipe to a linear-probe score (no per-chunk min-max)."""
+    import numpy as np
+    import torch
+    from torch import nn
+    from vesuvius.ink_detection.training.dynamic_labels import (
+        DinoGridSpec,
+        ProbeGuidedLabelGenerator,
+    )
+
+    class _Dino(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.p = nn.Parameter(torch.zeros(1))
+
+        def forward_features(self, x):
+            tok = torch.zeros(x.shape[0], 16 ** 3, 864, dtype=x.dtype, device=x.device)
+            tok[..., 0] = 1.0
+            return {"x_norm_patchtokens": tok}
+
+    class _UNet(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.p = nn.Parameter(torch.zeros(1))
+
+        def forward(self, x):
+            return {"ink": torch.full_like(x, 10.0)}
+
+    coef = np.zeros(864, np.float32)
+    coef[0] = 2.0
+    gen = ProbeGuidedLabelGenerator(
+        probe_coef=torch.from_numpy(coef), probe_intercept=-1.0, unet=_UNet(), dino=_Dino(),
+        device="cpu", dtype=torch.float32, dino_stride=128, grid=DinoGridSpec(),
+    )
+    image = torch.rand(1, 1, 256, 256, 256)
+    similarity = gen._dino_similarity(image)
+    expected = float(torch.sigmoid(torch.tensor(1.0)))
+    assert torch.allclose(similarity, torch.full_like(similarity, expected), atol=1e-4)
+    assert gen.generate(image).mean().item() == 1.0
