@@ -612,18 +612,115 @@ class SelfDistillLabelGenerator:
         return output
 
 
+def load_probe_weights(
+    source: str | Path, *, embedding_dim: int
+) -> tuple[torch.Tensor, float]:
+    """Load a linear probe (.npz with ``coef`` of shape (embedding_dim,) and ``intercept``)."""
+
+    payload = np.load(str(source))
+    coef = np.asarray(payload["coef"], dtype=np.float32)
+    if coef.shape != (embedding_dim,):
+        raise ValueError(
+            f"probe coef must have shape ({embedding_dim},), got {coef.shape}"
+        )
+    return torch.from_numpy(coef), float(payload["intercept"])
+
+
+class ProbeGuidedLabelGenerator(DinoGuidedLabelGenerator):
+    """DINO-guided labels with a linear probe instead of the prototype cosine.
+
+    Identical windows, stride, blending, upsampling, U-Net and label rule; the per-token
+    score is ``sigmoid(normalize(token) . coef + intercept)`` and there is no per-chunk
+    min-max normalisation.
+    """
+
+    def __init__(self, *, probe_coef: torch.Tensor, probe_intercept: float, **kwargs: Any) -> None:
+        grid = kwargs.get("grid") or DinoGridSpec()
+        super().__init__(reference_embedding=torch.ones(grid.embedding_dim), **kwargs)
+        self.probe_coef = torch.as_tensor(probe_coef, dtype=torch.float32).to(self.device)
+        self.probe_intercept = float(probe_intercept)
+
+    @classmethod
+    def from_mapping(
+        cls,
+        config: Any,
+        *,
+        device: torch.device | str = "cuda",
+        dtype: torch.dtype = torch.bfloat16,
+    ) -> ProbeGuidedLabelGenerator:
+        grid = DinoGridSpec()
+        coef, intercept = load_probe_weights(
+            _config_value(config, "probe_weights"), embedding_dim=grid.embedding_dim
+        )
+        return cls(
+            probe_coef=coef,
+            probe_intercept=intercept,
+            unet=load_frozen_ink_model(
+                _config_alias(config, "unet_ckpt", "unet_checkpoint"), device=device, dtype=dtype
+            ),
+            dino=load_frozen_dino_backbone(
+                _config_alias(config, "dino_ckpt", "dino_checkpoint"), device=device, dtype=dtype
+            ),
+            device=device,
+            dtype=dtype,
+            dino_stride=int(_config_value(config, "dino_stride", 64)),
+            dino_minibatch=int(_config_value(config, "dino_minibatch", 8)),
+            dino_blend_sigma=float(_config_value(config, "dino_blend_sigma", 4.0)),
+            threshold=float(_config_value(config, "threshold", 0.5)),
+            grid=grid,
+        )
+
+    def _token_scores(self, tokens: torch.Tensor) -> torch.Tensor:
+        return torch.sigmoid(F.normalize(tokens.float(), dim=-1) @ self.probe_coef + self.probe_intercept)
+
+    @torch.inference_mode()
+    def _dino_similarity(self, image_b1zyx: torch.Tensor) -> torch.Tensor:
+        batch_size = int(image_b1zyx.shape[0])
+        grid = self.grid
+        width = grid.tokens_per_window_axis
+        coordinates = [(z, y, x) for z in self.starts for y in self.starts for x in self.starts]
+        accumulator = torch.zeros(
+            (batch_size,) + (grid.tokens_per_chunk_axis,) * 3, device=self.device, dtype=torch.float32
+        )
+        weight_accumulator = torch.zeros_like(accumulator)
+        for start in range(0, len(coordinates), self.dino_minibatch):
+            batch_coords = coordinates[start:start + self.dino_minibatch]
+            windows = torch.cat([
+                image_b1zyx[:, :, z0:z0 + grid.window_size, y0:y0 + grid.window_size, x0:x0 + grid.window_size]
+                for z0, y0, x0 in batch_coords
+            ]).to(device=self.device, dtype=self.dtype)
+            tokens = self.dino.forward_features(windows)["x_norm_patchtokens"]
+            scores = self._token_scores(tokens).reshape(len(batch_coords), batch_size, width, width, width)
+            for j, (z0, y0, x0) in enumerate(batch_coords):
+                oz, oy, ox = z0 // grid.patch_size, y0 // grid.patch_size, x0 // grid.patch_size
+                slices = (slice(None), slice(oz, oz + width), slice(oy, oy + width), slice(ox, ox + width))
+                accumulator[slices] += scores[j] * self.weight
+                weight_accumulator[slices] += self.weight
+        similarity_grid = accumulator / weight_accumulator.clamp_min(1e-6)
+        return F.interpolate(
+            similarity_grid.unsqueeze(1), size=(grid.chunk_size,) * 3, mode="trilinear", align_corners=False
+        )
+
+
 def build_dynamic_label_generator(
     config: Any,
     *,
     device: torch.device | str,
     dtype: torch.dtype,
 ) -> DinoGuidedLabelGenerator | SelfDistillLabelGenerator:
-    """Build either opt-in engine from a mapping or typed config object."""
+    """Build an opt-in engine from a mapping or typed config object."""
 
     kind = _config_value(config, "kind")
     kind = getattr(kind, "value", kind)
     normalized = str(kind).strip().lower()
     if normalized == "dino_guided":
+        probe = _config_value(config, "probe_weights", None)
+        if probe not in (None, ""):
+            return ProbeGuidedLabelGenerator.from_mapping(
+                config,
+                device=device,
+                dtype=dtype,
+            )
         return DinoGuidedLabelGenerator.from_mapping(
             config,
             device=device,
